rules_version = '2';

// accessbelt-operator database. No collections/schema exist yet — the
// Operator Portal currently runs entirely on mock data (src/data/mockData.ts).
// Deny-all until a schema (inventory, shifts, announcements, multi-operator
// access control) is designed and real rules are written against it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
