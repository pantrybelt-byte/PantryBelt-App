{
  "cli": {
    "version": ">= 13.0.0",
    "requireCommit": true,
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Debug"
      },
      "android": {
        "buildType": "apk"
      },
      "node": "24.14.0"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "node": "24.14.0"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "ios": {
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "node": "24.14.0"
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "${PLAY_STORE_SERVICE_ACCOUNT_KEY_PATH:-/Users/Thad/.config/accessbelt/google-service-account.json}",
        "track": "internal"
      },
      "ios": {
        "appleId": "clarke.matthew95@gmail.com",
        "ascAppId": "6800192694",
        "appleTeamId": "G8VHN2YTZ8"
      }
    }
  }
}
