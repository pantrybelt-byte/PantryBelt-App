# B.L.A.S.T. — ephemeral workbench (keep folder via .gitkeep)
.tmp/*
!.tmp/.gitkeep

# Dependencies
node_modules/

# Expo / Metro
.expo/
dist/
web-build/

# Env (never commit secrets)
.env
.env.local
.env.*.local

# Firebase service account & admin SDK credentials (never commit)
serviceAccountKey.json
*-firebase-adminsdk-*.json

# Google Play service account key (used by EAS submit — never commit)
google-service-account.json

# Large archive files
*.zip
*.apk
*.aab

# VS Code
.vscode/

# OS
.DS_Store
*.log
Pantry-Belt-Landing-Page-/

# Native prebuild output (Expo managed workflow) — regenerated by
# `expo prebuild` / EAS Build from app.config.js; never commit, since the
# generated AndroidManifest.xml bakes in EXPO_PUBLIC_* keys as plaintext.
android/
ios/

# Signing credentials — never commit; let EAS manage build credentials.
*.jks
*.keystore
