{
  "firestore": [
    {
      "database": "(default)",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    },
    {
      "database": "accessbelt-agency",
      "rules": "firestore.agency.rules",
      "indexes": "firestore.empty.indexes.json"
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    }
  },
  "extensions": {
    "fs-bq-monthly-summary": "firebase/firestore-bigquery-export@0.3.2",
    "fs-bq-referrals": "firebase/firestore-bigquery-export@0.3.2",
    "fs-bq-pantry-engagements": "firebase/firestore-bigquery-export@0.3.2",
    "fs-bq-search-outcomes": "firebase/firestore-bigquery-export@0.3.2",
    "fs-bq-searches": "firebase/firestore-bigquery-export@0.3.2",
    "fs-bq-sessions": "firebase/firestore-bigquery-export@0.3.2",
    "fs-bq-food-deserts": "firebase/firestore-bigquery-export@0.3.2",
    "fs-bq-user-counties": "firebase/firestore-bigquery-export@0.3.2"
  }
}
