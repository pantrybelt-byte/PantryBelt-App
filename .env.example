# AccessBelt — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.

# Firebase Web API Key (from Firebase Console → Project Settings → General)
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here

# Google Maps API Key for Android map rendering (from Google Cloud Console).
# Restrict it in Cloud Console to Android apps, matching the package name
# (com.accessbelt.app) + the SHA-1 signing cert fingerprint(s) for your EAS
# build credentials. iOS intentionally has no equivalent key/env var — it
# renders with Apple Maps (PROVIDER_DEFAULT), not Google Maps.
GOOGLE_MAPS_ANDROID_KEY=your_google_maps_android_key_here

# Google Maps Geocoding API Key for developer seeding/maintenance scripts.
# Kept in local .env only; never needed in client apps or EAS builds.
GOOGLE_MAPS_GEOCODING_KEY=your_google_maps_geocoding_key_here

# Local Service Account File Paths (moved outside repo to ~/.config/accessbelt/)
# Used by local admin scripts (seedFirestore, migrations) and EAS Submit
GOOGLE_APPLICATION_CREDENTIALS=/Users/your_user/.config/accessbelt/serviceAccountKey.json
PLAY_STORE_SERVICE_ACCOUNT_KEY_PATH=/Users/your_user/.config/accessbelt/google-service-account.json

# Stable per-app-instance session identifier used by the analytics/session bootstrap
EXPO_PUBLIC_APP_SESSION_ID=your_app_session_id_here
